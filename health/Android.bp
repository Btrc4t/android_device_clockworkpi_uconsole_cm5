cc_binary {
    name: "android.hardware.health-service.uconsole",
    relative_install_path: "hw",
    vendor: true,
    overrides: [
        "charger",
        "android.hardware.health-service.rpi"
    ],
    defaults: [
        "libhealth_aidl_impl_user",
    ],
    srcs: [
        "ChargerUtils.cpp",
        "health-convert.cpp",
        "HalHealthLoop.cpp",
        "Health.cpp",
        "LinkedCallback.cpp",
        "main.cpp",
    ],
    static_libs: [
        "libbatterymonitor",
        "libhealth_aidl_impl",
        "libhealth_aidl_impl_user",
        "libhealthloop",
    ],
    shared_libs: [
        "android.hardware.health-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.health-service.uconsole.rc",
    src: "android.hardware.health-service.uconsole.rc",
    overrides: ["android.hardware.health-service.rpi.rc"],
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.health-service.uconsole.xml",
    src: "android.hardware.health-service.uconsole.xml",
    overrides: ["android.hardware.health-service.rpi.xml"],
    sub_dir: "vintf",
    installable: false,
}

apex {
    name: "com.android.hardware.health.uconsole",
    overrides: ["com.android.hardware.health.rpi5"],
    manifest: "apex_manifest.json",
    file_contexts: "apex_file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,

    binaries: ["android.hardware.health-service.uconsole"],
    prebuilts: [
        "android.hardware.health-service.uconsole.rc",
        "android.hardware.health-service.uconsole.xml",
    ],
}
